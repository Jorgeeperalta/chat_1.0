# Configuración de la Aplicación
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# Configuración de la Base de Datos MySQL
# ============================================
DB_HOST=mysql5050.site4now.net
DB_PORT=3306
DB_NAME=db_a47d48_chat
DB_USER=a47d48_chat
DB_PASSWORD=Afm123$$
DB_DIALECT=mysql
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# ============================================
# Configuración de JWT (Autenticación)
# ============================================
JWT_SECRET=your_very_strong_secret_key_here_change_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# Configuración de Socket.io
# ============================================
SOCKET_IO_CORS_ORIGIN=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,http://127.0.0.1:5173
SOCKET_IO_PATH=/socket.io
SOCKET_IO_PING_TIMEOUT=20000
SOCKET_IO_PING_INTERVAL=25000

# ============================================
# Configuración de Mistral AI API
# ============================================
MISTRAL_API_KEY=mstrl_pFJD1htc8zChzv5ITbV688yTHMHZ0eOV_2cWIuI
MISTRAL_API_BASE_URL=https://api.mistral.ai/v1
MISTRAL_TRANSLATION_MODEL=mistral-small
MISTRAL_MAX_TOKENS=1000
MISTRAL_TEMPERATURE=0.7
MISTRAL_TIMEOUT_MS=30000

# Opcional: Configuración para fallback a otro proveedor
FALLBACK_TRANSLATION_API=google
FALLBACK_API_KEY=

# ============================================
# Configuración de Almacenamiento de Archivos
# ============================================
# Opción 1: Sistema de archivos local
STORAGE_TYPE=local
UPLOADS_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_AUDIO_TYPES=audio/mpeg,audio/wav,audio/ogg,audio/mp3,audio/webm
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Opción 2: AWS S3 (descomentar y configurar si se usa)
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=
# AWS_S3_PUBLIC_URL=

# ============================================
# Configuración de Seguimiento y Logging
# ============================================
LOG_LEVEL=info
LOG_FILE=logs/app.log
MAX_LOG_FILES=10
LOG_FILE_SIZE_MB=10

# ============================================
# Configuración de Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=15 * 60 * 1000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MESSAGE=Too many requests, please try again later

# ============================================
# Configuración de CORS
# ============================================
CORS_ORIGIN=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,http://127.0.0.1:5173
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,X-Requested-With,Content-Type,Accept,Authorization
CORS_CREDENTIALS=true

# ============================================
# Configuración de Seguridad
# ============================================
HELMET_ENABLED=true
TRUST_PROXY=false

# ============================================
# Configuración de Cache de Traducciones
# ============================================
TRANSLATION_CACHE_ENABLED=true
TRANSLATION_CACHE_TTL_HOURS=24

# ============================================
# NOTA IMPORTANTE:
# ============================================
# 1. Copiar este archivo a .env y modificar los valores
# 2. NUNCA commémitar el archivo .env a Git
# 3. Para producción, usar variables de entorno del sistema
# 4. Las claves API deben mantenerse en secreto