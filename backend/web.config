<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración de IIS + iisnode para SmarterASP.NET (http://jorgeperalta-001-site4.itempurl.com/)
  Node atiende todo: API (/api), Socket.io (/socket.io), archivos (/uploads) y el frontend (public/).
-->
<configuration>
  <system.webServer>
    <!-- Desactivar el módulo WebSocket de IIS para que iisnode pase los WebSockets a Node -->
    <webSocket enabled="false" />

    <handlers>
      <add name="iisnode" path="src/index.js" verb="*" modules="iisnode" />
    </handlers>

    <iisnode
      nodeProcessCountPerApplication="1"
      enableXFF="true"
      watchedFiles="web.config;.env;src\index.js"
      loggingEnabled="true"
      logDirectory="iisnode"
      devErrorsEnabled="false"
      maxRequestEntitySize="15728640"
    />

    <rewrite>
      <rules>
        <!-- Todo lo atiende la app de Node (los logs de iisnode se leen por FTP) -->
        <rule name="node-app">
          <match url=".*" />
          <action type="Rewrite" url="src/index.js" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- No exponer configuración ni dependencias -->
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
          <add segment="logs" />
          <add segment="iisnode" />
        </hiddenSegments>
        <!-- Audios de hasta ~15 MB -->
        <requestLimits maxAllowedContentLength="15728640" />
      </requestFiltering>
    </security>

    <!-- Que IIS devuelva los errores de Node tal cual (JSON de la API) -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
