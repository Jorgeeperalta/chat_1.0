<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración de IIS + HttpPlatformHandler para SmarterASP.NET (http://jorgeperalta-001-site4.itempurl.com/)
  IIS lanza "node src\index.js" y le reenvía todas las peticiones: API (/api), Socket.io (/socket.io),
  archivos (/uploads) y el frontend (public/).
-->
<configuration>
  <system.webServer>
    <!-- Con HttpPlatformHandler el módulo WebSocket de IIS debe estar activo para que Socket.io use WebSockets -->
    <webSocket enabled="true" />

    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" />
    </handlers>

    <httpPlatform processPath="node" arguments="src\index.js" startupTimeLimit="20" startupRetryCount="1" stdoutLogEnabled="true" stdoutLogFile=".\log.txt">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>

    <security>
      <requestFiltering>
        <!-- No exponer configuración ni dependencias -->
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
          <add segment="logs" />
          <add segment="log.txt" />
        </hiddenSegments>
        <!-- Audios de hasta ~15 MB -->
        <requestLimits maxAllowedContentLength="15728640" />
      </requestFiltering>
    </security>

    <!-- Que IIS devuelva los errores de Node tal cual (JSON de la API) -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
