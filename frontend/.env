# ============================================
# Configuración del Frontend
# ============================================
NODE_ENV=development

# ============================================
# Configuración de la API Backend
# ============================================
VITE_API_BASE_URL=http://localhost:3000
VITE_API_TIMEOUT=30000

# ============================================
# Configuración de Socket.io
# ============================================
VITE_SOCKET_IO_URL=http://localhost:3000
VITE_SOCKET_IO_PATH=/socket.io
VITE_SOCKET_IO_RECONNECTION_ATTEMPTS=5
VITE_SOCKET_IO_RECONNECTION_DELAY=1000

# ============================================
# Configuración de Mistral AI (opcional, solo para pruebas locales)
# ============================================
# Nota: El backend maneja la API de Mistral, pero si quieres hacer llamadas directas:
VITE_MISTRAL_API_KEY=mstrl_pFJD1htc8zChzv5ITbV688yTHMHZ0eOV_2cWIuI
VITE_MISTRAL_API_BASE_URL=https://api.mistral.ai/v1

# ============================================
# Configuración de Almacenamiento
# ============================================
VITE_UPLOADS_BASE_URL=/uploads

# ============================================
# Configuración de Autenticación
# ============================================
VITE_TOKEN_STORAGE_KEY=chat_app_token
VITE_REFRESH_TOKEN_STORAGE_KEY=chat_app_refresh_token
VITE_TOKEN_EXPIRY_KEY=chat_app_token_expiry

# ============================================
# Configuración de la Aplicación
# ============================================
VITE_APP_NAME=Chat Translate App
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Chat con Traducción en Tiempo Real

# ============================================
# Configuración de Tema (Vuetify)
# ============================================
VITE_DEFAULT_THEME=system
VITE_DARK_THEME_PRIMARY=1867C0
VITE_DARK_THEME_SECONDARY=5CBBF6
VITE_DARK_THEME_ACCENT=42D692
VITE_LIGHT_THEME_PRIMARY=1867C0
VITE_LIGHT_THEME_SECONDARY=5CBBF6
VITE_LIGHT_THEME_ACCENT=42D692

# ============================================
# Configuración de Idiomas
# ============================================
VITE_DEFAULT_LANGUAGE=es
VITE_FALLBACK_LANGUAGE=en

# ============================================
# Configuración de Audio
# ============================================
VITE_AUDIO_QUALITY=medium
VITE_MAX_AUDIO_DURATION=300

# ============================================
# Configuración de Paginación
# ============================================
VITE_MESSAGES_PER_PAGE=50
VITE_CONVERSATIONS_PER_PAGE=20

# ============================================
# Configuración de Notificaciones
# ============================================
VITE_NOTIFICATION_SOUND_ENABLED=true
VITE_NOTIFICATION_VIBRATION_ENABLED=true
VITE_PLAY_AUDIO_AUTOMATICALLY=false

# ============================================
# NOTA IMPORTANTE:
# ============================================
# 1. Copiar este archivo a .env.local y modificar los valores
# 2. NUNCA committear variables de entorno sensibles a Git
# 3. Para producción, usar variables de entorno del sistema
# 4. Las claves API deben mantenerse en secreto
