# ============================================
# Build de producción (npm run build)
# Vite carga este archivo encima de .env al compilar.
# ============================================
# La app se sirve desde el mismo servidor que la API y Socket.io
# (http://jorgeperalta-001-site4.itempurl.com/), así que las URLs quedan vacías
# y todas las peticiones son relativas al mismo origen.
VITE_API_BASE_URL=
VITE_SOCKET_IO_URL=
VITE_SOCKET_IO_PATH=/socket.io
VITE_UPLOADS_BASE_URL=

# Nunca poner claves de API en variables VITE_: terminan dentro del JavaScript público
VITE_MISTRAL_API_KEY=
